code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_toon, specular_disabled, unshaded, shadows_disabled, ambient_light_disabled;

uniform sampler2D tex_frg_2;
uniform float Gradient1_Slider : hint_range(1.39999997615814, 2.0) = 1.39999997615814;
uniform sampler2D tex_frg_7;
uniform sampler2D tex_frg_10;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p4 = n_out2p0.a;


// Input:3
	vec2 n_out3p0 = UV;


// VectorOp:9
	vec2 n_in9p1 = vec2(0.25000, 0.00000);
	vec2 n_out9p0 = n_out3p0 * n_in9p1;


// FloatParameter:5
	float n_out5p0 = Gradient1_Slider;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = vec2(n_out5p0) * n_in4p1 + n_out9p0;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, n_out4p0);
	float n_out7p4 = n_out7p0.a;


// VectorOp:8
	vec3 n_out8p0 = vec3(n_out7p4) * vec3(n_out2p4);


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, UV);
	float n_out10p4 = n_out10p0.a;


// VectorOp:11
	vec3 n_out11p0 = n_out8p0 * vec3(n_out10p4);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out11p0.x;


}

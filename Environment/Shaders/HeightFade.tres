code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 var_CameraPosition;
varying vec3 var_CurrentPosition;

uniform bool UseAlbedoTexture;
uniform sampler2D AlbedoTexture : source_color, repeat_disable;
uniform vec4 ColorParameter : source_color = vec4(0.141101, 0.103374, 0.063537, 1.000000);
uniform float CameraHideHeight = 1.0;



void vertex() {
// Input:9
	vec3 n_out9p0 = CAMERA_POSITION_WORLD;


// VaryingSetter:3
	var_CameraPosition = n_out9p0;


// Input:7
	mat4 n_out7p0 = MODEL_MATRIX;


// Input:6
	vec3 n_out6p0 = VERTEX;


// TransformVectorMult:8
	vec3 n_out8p0 = (n_out7p0 * vec4(n_out6p0, 1.0)).xyz;


// VaryingSetter:4
	var_CurrentPosition = n_out8p0;


}

void fragment() {
// BooleanParameter:24
	bool n_out24p0 = UseAlbedoTexture;


	vec4 n_out23p0;
// Texture2D:23
	n_out23p0 = texture(AlbedoTexture, UV);


// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


	vec3 n_out25p0;
// Switch:25
	n_out25p0 = mix(vec3(n_out2p0.xyz), vec3(n_out23p0.xyz), float(n_out24p0));


// VaryingGetter:6
	vec3 n_out6p0 = var_CurrentPosition;


// VectorDecompose:7
	float n_out7p0 = n_out6p0.x;
	float n_out7p1 = n_out6p0.y;
	float n_out7p2 = n_out6p0.z;


// FloatFunc:8
	float n_out8p0 = 1.0 - n_out7p1;


// FloatFunc:18
	float n_out18p0 = min(max(n_out8p0, 0.0), 1.0);


// VaryingGetter:17
	vec3 n_out17p0 = var_CameraPosition;


// VectorDecompose:5
	float n_out5p0 = n_out17p0.x;
	float n_out5p1 = n_out17p0.y;
	float n_out5p2 = n_out17p0.z;


// FloatParameter:11
	float n_out11p0 = CameraHideHeight;


	float n_out19p0;
// Remap:19
	float n_in19p1 = -6.00000;
	float n_in19p3 = 0.00000;
	float n_in19p4 = 1.00000;
	{
		float __input_range = n_out11p0 - n_in19p1;
		float __output_range = n_in19p4 - n_in19p3;
		n_out19p0 = n_in19p3 + __output_range * ((n_out5p1 - n_in19p1) / __input_range);
	}


// Clamp:21
	float n_in21p1 = 0.00000;
	float n_in21p2 = 1.00000;
	float n_out21p0 = clamp(n_out19p0, n_in21p1, n_in21p2);


// FloatFunc:20
	float n_out20p0 = 1.0 - n_out21p0;


// FloatOp:10
	float n_out10p0 = n_out18p0 * n_out20p0;


// Output:0
	ALBEDO = n_out25p0;
	ALPHA = n_out10p0;


}

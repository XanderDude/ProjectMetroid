[gd_resource type="ShaderMaterial" load_steps=2 format=3 uid="uid://b8yeulj3n71qh"]

[sub_resource type="Shader" id="Shader_f2trv"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.1.stable.mono's StandardMaterial3D.

shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_front, diffuse_toon, specular_disabled, unshaded, ambient_light_disabled;

uniform float alpha : hint_range(0.0, 1.0, 0.01);
uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float grow : hint_range(-16.0, 16.0, 0.001);
uniform float proximity_fade_distance : hint_range(0.0, 4096.0, 0.01);

uniform sampler2D depth_texture : hint_depth_texture, repeat_disable, filter_nearest;

void vertex() {

	// Grow: Enabled
	VERTEX += NORMAL * grow;
}

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	ALPHA *= alpha * albedo_tex.a;

	// Proximity Fade: Enabled
	float proximity_depth_tex = textureLod(depth_texture, SCREEN_UV, 0.0).r;
	vec4 proximity_view_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, proximity_depth_tex, 1.0);
	proximity_view_pos.xyz /= proximity_view_pos.w;
	ALPHA *= clamp(1.0 - smoothstep(proximity_view_pos.z + proximity_fade_distance, proximity_view_pos.z, VERTEX.z), 0.0, 1.0);
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_f2trv")
shader_parameter/alpha = 0.0
shader_parameter/albedo = Color(0.686275, 0.686275, 0.686275, 1)
shader_parameter/grow = 0.0200008
shader_parameter/proximity_fade_distance = 1.0
